    function initCharts() {
      Chart.defaults.font.family = 'Prompt, sans-serif';
      Chart.defaults.color = '#4A2E2B';

      // 1. Flavor Chart (Bar Chart)
      const ctxFlavor = document.getElementById('flavorChart').getContext('2d');
      chartInstances.flavor = new Chart(ctxFlavor, {
        type: 'bar',
        data: {
          labels: ['บลูเบอร์รี่ 🫐', 'สตรอว์เบอร์รี่ 🍓', 'ช็อกโกแลต 🍫', 'โอริโอ้ 🍪'],
          datasets: [{
            label: 'จำนวนคนสนใจ',
            data: [0, 0, 0, 0],
            backgroundColor: ['#4F46E5', '#E11D48', '#78350F', '#334155'],
            borderRadius: 12,
            borderSkipped: false
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false }
          },
          scales: {
            y: { beginAtZero: true, ticks: { stepSize: 1 } }
          }
        }
      });

      // 2. Age Chart (Bar Chart)
      const ctxAge = document.getElementById('ageChart').getContext('2d');
      chartInstances.age = new Chart(ctxAge, {
        type: 'bar',
        data: {
          labels: ['ต่ำกว่า 15 ปี', '15–18 ปี', '19–22 ปี', '23 ปีขึ้นไป'],
          datasets: [{
            label: 'จำนวนผู้ประเมิน',
            data: [0, 0, 0, 0],
            backgroundColor: '#F4A261',
            borderRadius: 10
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
      });

      // 3. Gender Chart (Doughnut Chart)
      const ctxGender = document.getElementById('genderChart').getContext('2d');
      chartInstances.gender = new Chart(ctxGender, {
        type: 'doughnut',
        data: {
          labels: ['ชาย', 'หญิง', 'ไม่ประสงค์ระบุ'],
          datasets: [{
            data: [0, 0, 0],
            backgroundColor: ['#3B82F6', '#EC4899', '#A855F7'],
            borderWidth: 2,
            borderColor: '#FFFFFF'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom' }
          }
        }
      });

      // 4. Experience Chart (Pie Chart)
      const ctxExp = document.getElementById('experienceChart').getContext('2d');
      chartInstances.experience = new Chart(ctxExp, {
        type: 'pie',
        data: {
          labels: ['เคยทานชีสพาย', 'ไม่เคยทาน'],
          datasets: [{
            data: [0, 0],
            backgroundColor: ['#10B981', '#F97316'],
            borderWidth: 2,
            borderColor: '#FFFFFF'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom' }
          }
        }
      });
    }

    // Re-calculate statistics and update Dashboard UI
    function updateDashboardData() {
      const total = evaluationList.length;

      // Update KPI Total
      document.getElementById('kpi-total').innerText = total;

      if (total === 0) {
        document.getElementById('kpi-top-flavor').innerText = '-';
        document.getElementById('kpi-top-flavor-count').innerText = '0 คะแนน';
        document.getElementById('kpi-top-age').innerText = '-';
        document.getElementById('kpi-top-age-pct').innerText = '0%';
        document.getElementById('kpi-eaten-ratio').innerText = '0%';

        // Reset charts data
        Object.keys(chartInstances).forEach(key => {
          chartInstances[key].data.datasets[0].data = chartInstances[key].data.datasets[0].data.map(() => 0);
          chartInstances[key].update();
        });

        renderSuggestionsFeed([]);
        return;
      }

      // 1. Calculate Flavors
      const flavorCounts = {
        'บลูเบอร์รี่ชีสพาย 🫐': 0,
        'สตรอว์เบอร์รี่ชีสพาย 🍓': 0,
        'ช็อกโกแลตชีสพาย 🍫': 0,
        'โอริโอ้ชีสพาย 🍪': 0
      };

      // 2. Calculate Ages
      const ageCounts = {
        'ต่ำกว่า 15 ปี': 0,
        '15–18 ปี': 0,
        '19–22 ปี': 0,
        '23 ปีขึ้นไป': 0
      };

      // 3. Calculate Gender
      const genderCounts = {
        'ชาย': 0,
        'หญิง': 0,
        'ไม่ประสงค์ระบุ': 0
      };

      // 4. Calculate Experience
      let eatenCount = 0;
      let notEatenCount = 0;

      const validSuggestions = [];

      evaluationList.forEach(item => {
        if (flavorCounts[item.favoriteFlavor] !== undefined) flavorCounts[item.favoriteFlavor]++;
        if (ageCounts[item.age] !== undefined) ageCounts[item.age]++;
        if (genderCounts[item.gender] !== undefined) genderCounts[item.gender]++;
        
        if (item.hasEaten === 'เคย') eatenCount++;
        else notEatenCount++;

        if (item.suggestion && item.suggestion.trim() !== '') {
          validSuggestions.push(item);
        }
      });

      // Update Flavor Chart
      chartInstances.flavor.data.datasets[0].data = [
        flavorCounts['บลูเบอร์รี่ชีสพาย 🫐'],
        flavorCounts['สตรอว์เบอร์รี่ชีสพาย 🍓'],
        flavorCounts['ช็อกโกแลตชีสพาย 🍫'],
        flavorCounts['โอริโอ้ชีสพาย 🍪']
      ];
      chartInstances.flavor.update();

      // Top Flavor KPI calculation
      let topFlavor = '-';
      let maxFlavorVal = -1;
      Object.keys(flavorCounts).forEach(f => {
        if (flavorCounts[f] > maxFlavorVal) {
          maxFlavorVal = flavorCounts[f];
          topFlavor = f;
        }
      });
      document.getElementById('kpi-top-flavor').innerText = topFlavor;
      document.getElementById('kpi-top-flavor-count').innerText = `${maxFlavorVal} เสียง (${Math.round((maxFlavorVal / total) * 100)}%)`;

      // Update Age Chart
      chartInstances.age.data.datasets[0].data = [
        ageCounts['ต่ำกว่า 15 ปี'],
        ageCounts['15–18 ปี'],
        ageCounts['19–22 ปี'],
        ageCounts['23 ปีขึ้นไป']
      ];
      chartInstances.age.update();

      // Top Age KPI calculation
      let topAge = '-';
      let maxAgeVal = -1;
      Object.keys(ageCounts).forEach(a => {
        if (ageCounts[a] > maxAgeVal) {
          maxAgeVal = ageCounts[a];
          topAge = a;
        }
      });
      document.getElementById('kpi-top-age').innerText = topAge;
      document.getElementById('kpi-top-age-pct').innerText = `${Math.round((maxAgeVal / total) * 100)}% ของทั้งหมด`;

      // Update Gender Chart
      chartInstances.gender.data.datasets[0].data = [
        genderCounts['ชาย'],
        genderCounts['หญิง'],
        genderCounts['ไม่ประสงค์ระบุ']
      ];
      chartInstances.gender.update();

      // Update Experience Chart & KPI
      chartInstances.experience.data.datasets[0].data = [eatenCount, notEatenCount];
      chartInstances.experience.update();

      const eatenPct = Math.round((eatenCount / total) * 100);
      document.getElementById('kpi-eaten-ratio').innerText = `${eatenPct}%`;

      // Render Suggestions List Feed
      renderSuggestionsFeed(validSuggestions);
    }

    // Render Suggested Flavors List
    function renderSuggestionsFeed(suggestions) {
      const feed = document.getElementById('suggestionsFeed');
      const countBadge = document.getElementById('suggestions-count-badge');

      countBadge.innerText = `${suggestions.length} ความเห็น`;

      if (suggestions.length === 0) {
        feed.innerHTML = `
          <div class="text-center py-8 text-choco-soft text-sm bg-cream-bg rounded-2xl border border-dashed border-cream-border">
            <i class="fa-regular fa-comment-dots text-2xl mb-2 text-honey opacity-60"></i>
            <p>ยังไม่มีข้อเสนอแนะรสชาติเพิ่มเติม</p>
          </div>
        `;
        return;
      }

      feed.innerHTML = suggestions.map(item => {
        const dateStr = item.timestamp ? new Date(item.timestamp).toLocaleDateString('th-TH', { hour: '2-digit', minute: '2-digit' }) : 'เมื่อสักครู่';
        return `
          <div class="p-4 rounded-2xl bg-cream-accent/40 border border-cream-border/60 hover:bg-cream-accent/70 transition">
            <div class="flex items-center justify-between mb-1.5">
              <div class="flex items-center gap-2 text-xs">
                <span class="font-bold text-choco">${escapeHtml(item.gender)} (${escapeHtml(item.age)})</span>
                <span class="text-choco-soft">• รสชาติโปรด: ${escapeHtml(item.favoriteFlavor)}</span>
              </div>
              <span class="text-[11px] text-choco-soft">${dateStr}</span>
            </div>
            <p class="text-sm text-choco font-medium flex items-start gap-2">
              <span class="text-honey-gold">💡</span>
              <span>"${escapeHtml(item.suggestion)}"</span>
            </p>
          </div>
        `;
      }).join('');
    }

    // Simple Helper to Escape HTML
    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }
  </script>

