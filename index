      { gender: 'หญิง', age: '19–22 ปี', hasEaten: 'เคย', favoriteFlavor: 'สตรอว์เบอร์รี่ชีสพาย 🍓', suggestion: 'รสยูสุเลมอนตระกูลส้มเปรี้ยวสดชื่น', timestamp: 1714512000000 },
      { gender: 'ไม่ประสงค์ระบุ', age: '15–18 ปี', hasEaten: 'เคย', favoriteFlavor: 'ช็อกโกแลตชีสพาย 🍫', suggestion: '', timestamp: 1714513000000 },
      { gender: 'หญิง', age: 'ต่ำกว่า 15 ปี', hasEaten: 'เคย', favoriteFlavor: 'บลูเบอร์รี่ชีสพาย 🫐', suggestion: 'รสแคนดี้สตรอว์เบอร์รี่ 🍓', timestamp: 1714514000000 }
    ];

    // State Variables
    let evaluationList = [];
    let chartInstances = {};

    // Initialization on Page Load
    window.onload = function() {
      loadEvaluationData();
      setupOptionSelectionStyles();
      initCharts();
      updateDashboardData();
    };

    // Load Data from LocalStorage or seed mock data
    function loadEvaluationData() {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored) {
        try {
          evaluationList = JSON.parse(stored);
        } catch(e) {
          evaluationList = [...INITIAL_MOCK_DATA];
        }
      } else {
        evaluationList = [...INITIAL_MOCK_DATA];
        saveEvaluationData();
      }
      updateBadgeCount();
    }

    // Save Data to LocalStorage
    function saveEvaluationData() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(evaluationList));
      updateBadgeCount();
    }

    function updateBadgeCount() {
      const badge = document.getElementById('badge-count');
      if (badge) badge.innerText = evaluationList.length;
    }

    // Tab Switching Logic
    function switchTab(tabName) {
      const formContent = document.getElementById('tab-content-form');
      const dashContent = document.getElementById('tab-content-dashboard');
      const formBtn = document.getElementById('tab-btn-form');
      const dashBtn = document.getElementById('tab-btn-dashboard');

      if (tabName === 'form') {
        formContent.classList.remove('hidden');
        dashContent.classList.add('hidden');
        formBtn.classList.add('active');
        dashBtn.classList.remove('active');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        formContent.classList.add('hidden');
        dashContent.classList.remove('hidden');
        dashBtn.classList.add('active');
        formBtn.classList.remove('active');
        updateDashboardData();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    // Radio Selection Card UI Handler
    function selectRadio(name, element) {
      // Unselect all other cards in same radio group
      const cards = document.querySelectorAll(`input[name="${name}"]`);
      cards.forEach(input => {
        const parentLabel = input.closest('.option-card');
        if (parentLabel) parentLabel.classList.remove('selected');
      });

      // Mark clicked card as selected
      element.classList.add('selected');
      const radioInput = element.querySelector('input[type="radio"]');
      if (radioInput) radioInput.checked = true;
    }

    function setupOptionSelectionStyles() {
      // Synchronize radio state if pre-selected
      document.querySelectorAll('input[type="radio"]:checked').forEach(radio => {
        const parent = radio.closest('.option-card');
        if (parent) parent.classList.add('selected');
      });
    }

    // Handle Form Submit
    function handleFormSubmit(event) {
      event.preventDefault();
      const form = event.target;
      
      const formData = new FormData(form);
      const gender = formData.get('gender');
      const age = formData.get('age');
      const hasEaten = formData.get('hasEaten');
      const favoriteFlavor = formData.get('favoriteFlavor');
      const suggestion = formData.get('newFlavorSuggestion') ? formData.get('newFlavorSuggestion').trim() : '';

      if (!gender || !age || !hasEaten || !favoriteFlavor) {
        showCustomAlert('กรุณากรอกข้อมูลส่วนบังคับให้ครบถ้วนก่อนส่งแบบประเมิน');
        return;
      }

      const newResponse = {
        gender,
        age,
        hasEaten,
        favoriteFlavor,
        suggestion,
        timestamp: new Date().getTime()
      };

      // Add to array
      evaluationList.unshift(newResponse);
      saveEvaluationData();

      // Reset Form UI
      form.reset();
      document.querySelectorAll('.option-card').forEach(card => card.classList.remove('selected'));

      // Show Success Modal
      showSuccessModal();
    }

    // Modal Control Functions
    function showSuccessModal() {
      const modal = document.getElementById('successModal');
      const content = document.getElementById('successModalContent');
      modal.classList.remove('opacity-0', 'pointer-events-none');
      content.classList.remove('scale-95');
      content.classList.add('scale-100');
    }

    function closeModalOnly() {
      const modal = document.getElementById('successModal');
      modal.classList.add('opacity-0', 'pointer-events-none');
    }

    function closeModalAndViewDashboard() {
      closeModalOnly();
      switchTab('dashboard');
    }

    function showCustomAlert(msg) {
      alert(msg); // standard soft alert backup
    }

    // Confirmation Modal for Clear Data
    function clearAllDataConfirm() {
      const modal = document.getElementById('confirmModal');
      modal.classList.remove('opacity-0', 'pointer-events-none');
    }

    function closeConfirmModal() {
      const modal = document.getElementById('confirmModal');
      modal.classList.add('opacity-0', 'pointer-events-none');
    }

    function executeClearAllData() {
      evaluationList = [];
      saveEvaluationData();
      closeConfirmModal();
      updateDashboardData();
    }

    // Add Random Mock Data Entry (+5)
    function addMockSampleData() {
      const genders = ['ชาย', 'หญิง', 'ไม่ประสงค์ระบุ'];
      const ages = ['ต่ำกว่า 15 ปี', '15–18 ปี', '19–22 ปี', '23 ปีขึ้นไป'];
      const eatenOpts = ['เคย', 'ไม่เคย'];
      const flavors = ['บลูเบอร์รี่ชีสพาย 🫐', 'สตรอว์เบอร์รี่ชีสพาย 🍓', 'ช็อกโกแลตชีสพาย 🍫', 'โอริโอ้ชีสพาย 🍪'];
      const suggestionsList = [
        'อยากได้รสชาเขียวมัทฉะเข้มข้นครับ',
        'รสราสเบอร์รี่เลมอนทาร์ต',
        'รสคาราเมลแมคคาเดเมีย 🌰',
        'ชีสเค้กถ้วยรสเสาวรสเปรี้ยวอมหวานสดชื่น',
        'รสเบอรี่รวม มิกซ์เบอร์รี่สเปเชียล',
        ''
      ];

      for (let i = 0; i < 5; i++) {
        const randomGender = genders[Math.floor(Math.random() * genders.length)];
        const randomAge = ages[Math.floor(Math.random() * ages.length)];
        const randomEaten = eatenOpts[Math.floor(Math.random() * eatenOpts.length)];
        const randomFlavor = flavors[Math.floor(Math.random() * flavors.length)];
        const randomSugg = suggestionsList[Math.floor(Math.random() * suggestionsList.length)];

        evaluationList.unshift({
          gender: randomGender,
          age: randomAge,
          hasEaten: randomEaten,
          favoriteFlavor: randomFlavor,
          suggestion: randomSugg,
          timestamp: Date.now() - (i * 3600000)
        });
      }

      saveEvaluationData();
      updateDashboardData();
    }

