<!DOCTYPE html>
<html lang="th" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DEKAUAN - CHEESECAKE CUP | แบบประเมินความพึงพอใจ</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts: Prompt -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
  
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Prompt', 'sans-serif'],
          },
          colors: {
            choco: {
              DEFAULT: '#4A2E2B',
              dark: '#351F1C',
              light: '#6F4E37',
              soft: '#8C684D'
            },
            cream: {
              bg: '#FAF6F0',
              card: '#FFFFFF',
              accent: '#FDF3E7',
              border: '#E8D8C8'
            },
            honey: {
              DEFAULT: '#F4A261',
              dark: '#E76F51',
              light: '#FFC896',
              gold: '#E59838'
            }
          }
        }
      }
    }
  </script>

  <style>
    body {
      font-family: 'Prompt', sans-serif;
      background-color: #FAF6F0;
      color: #4A2E2B;
    }
    
    /* Custom Stitched Border Effect like the Logo */
    .stitch-border {
      border: 2px dashed #D6A974;
    }
    
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #FAF6F0;
    }
    ::-webkit-scrollbar-thumb {
      background: #D6A974;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #E59838;
    }

    /* Option Radio Selection Card Styling */
    .option-card {
      transition: all 0.25s ease-in-out;
      cursor: pointer;
    }
    .option-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 16px -2px rgba(74, 46, 43, 0.08);
    }
    .option-card.selected {
      border-color: #E59838;
      background-color: #FDF3E7;
      box-shadow: 0 4px 12px rgba(229, 152, 56, 0.2);
    }
    
    /* Tab Active Underline Animation */
    .nav-tab {
      position: relative;
      transition: color 0.3s ease;
    }
    .nav-tab.active {
      color: #E59838;
      font-weight: 600;
    }
    .nav-tab.active::after {
      content: '';
      position: absolute;
      bottom: -4px;
      left: 0;
      right: 0;
      height: 3px;
      background-color: #E59838;
      border-radius: 9999px;
    }
  </style>
</head>

<body class="min-h-screen flex flex-col justify-between selection:bg-honey/30">

  <!-- TOP HEADER / NAVBAR -->
  <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-cream-border shadow-sm">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        
        <!-- Brand Logo & Name -->
        <div class="flex items-center gap-3 cursor-pointer" onclick="switchTab('form')">
          <!-- SVG Logo Replica matching user photo -->
          <div class="w-12 h-12 rounded-full bg-[#FAF0E4] stitch-border flex items-center justify-center p-1 shadow-inner relative flex-shrink-0">
            <svg viewBox="0 0 100 100" class="w-full h-full">
              <!-- Heart whisk icon -->
              <path d="M 50 20 C 40 10, 30 25, 50 42 C 70 25, 60 10, 50 20 Z" fill="none" stroke="#4A2E2B" stroke-width="4" stroke-linecap="round"/>
              <path d="M 45 22 C 38 16, 32 28, 48 38" fill="none" stroke="#4A2E2B" stroke-width="2"/>
              <path d="M 55 22 C 62 16, 68 28, 52 38" fill="none" stroke="#4A2E2B" stroke-width="2"/>
              <!-- Brand text curved style -->
              <text x="50" y="62" font-family="Prompt, sans-serif" font-weight="700" font-size="16" fill="#4A2E2B" text-anchor="middle">DEKAUAN</text>
              <text x="50" y="73" font-family="Prompt, sans-serif" font-weight="500" font-size="7" fill="#6F4E37" text-anchor="middle" letter-spacing="1">CHEESECAKE CUP</text>
              <!-- Drip line -->
              <path d="M 30 78 Q 40 86 50 80 T 70 78" fill="none" stroke="#F4A261" stroke-width="3" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <h1 class="text-xl font-bold tracking-tight text-choco leading-tight flex items-center gap-2">
              DEKAUAN
              <span class="text-xs bg-honey-light/40 text-choco-light font-normal px-2.5 py-0.5 rounded-full border border-honey/30 hidden sm:inline-block">Cheesecake Cup</span>
            </h1>
            <p class="text-xs text-choco-soft font-normal">แบบประเมินและสำรวจความพึงพอใจ</p>
          </div>
        </div>

        <!-- Navigation Tabs -->
        <nav class="flex items-center gap-6 sm:gap-8 text-sm sm:text-base font-medium">
          <button id="tab-btn-form" onclick="switchTab('form')" class="nav-tab active flex items-center gap-2 py-2 text-choco hover:text-honey-gold">
            <i class="fa-solid fa-pen-to-square"></i>
            <span>แบบประเมิน</span>
          </button>
          <button id="tab-btn-dashboard" onclick="switchTab('dashboard')" class="nav-tab flex items-center gap-2 py-2 text-choco hover:text-honey-gold">
            <i class="fa-solid fa-[#chart-pie] fa-chart-pie"></i>
            <span>ผลการประเมิน</span>
            <span id="badge-count" class="bg-honey text-white text-xs px-2 py-0.5 rounded-full font-semibold shadow-xs">0</span>
          </button>
        </nav>

      </div>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="flex-grow max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- ==================== TAB 1: EVALUATION FORM ==================== -->
    <section id="tab-content-form" class="space-y-8 animate-fade-in">
      
      <!-- HERO BANNER -->
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-choco via-choco-light to-choco text-white p-6 sm:p-10 shadow-xl">
        <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-honey/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
          
          <div class="md:col-span-8 space-y-3">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-md text-honey-light text-xs sm:text-sm font-medium border border-white/20">
              <i class="fa-solid fa-heart text-pink-400"></i> DEKAUAN Cheesecake Cup
            </div>
            <h2 class="text-2xl sm:text-4xl font-bold tracking-tight text-white leading-snug">
              ร่วมแชร์ความเห็นความอร่อย <br class="hidden sm:inline">เพื่อรสชาติที่ดีที่สุดสำหรับคุณ ✨
            </h2>
            <p class="text-sm sm:text-base text-cream-accent/90 max-w-xl">
              ขอเชิญทุกท่านร่วมทำแบบประเมินสั้นๆ เพื่อให้แบรนด์ <strong class="text-white font-semibold">DEKAUAN</strong> ได้พัฒนาชีสพายถ้วยโปรดของคุณให้หอม อร่อย และถูกใจยิ่งขึ้น
            </p>
          </div>

          <!-- Cheesecake Image Showcase -->
          <div class="md:col-span-4 flex justify-center md:justify-end">
            <div class="relative group">
              <div class="w-36 h-36 sm:w-44 sm:h-44 rounded-2xl overflow-hidden border-4 border-white/30 shadow-2xl rotate-3 group-hover:rotate-0 transition-transform duration-300">
                <img src="https://images.unsplash.com/photo-1533134242443-d4fd215305ad?auto=format&fit=crop&w=500&q=80" alt="Cheesecake Cup" class="w-full h-full object-cover">
              </div>
              <div class="absolute -bottom-3 -left-4 bg-white text-choco text-xs px-3 py-1.5 rounded-xl font-bold shadow-lg flex items-center gap-1.5 -rotate-6">
                <span>🫐🍓 🧀 หอม นุ่ม ละมุน</span>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- FORM CONTAINER -->
      <form id="evaluationForm" onsubmit="handleFormSubmit(event)" class="space-y-8">

        <!-- SECTION 1: ข้อมูลทั่วไป -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-cream-border/60 relative overflow-hidden">
          <div class="absolute top-0 left-0 w-2 h-full bg-honey"></div>
          
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-cream-border/40">
            <span class="w-10 h-10 rounded-2xl bg-honey/15 text-honey-gold flex items-center justify-center font-bold text-lg">1</span>
            <div>
              <h3 class="text-xl font-bold text-choco">ส่วนที่ 1 ข้อมูลทั่วไป</h3>
              <p class="text-xs text-choco-soft">ข้อมูลประชากรศาสตร์เบื้องต้นของผู้ตอบแบบประเมิน</p>
            </div>
          </div>

          <div class="space-y-8">

            <!-- 1.1 Gender -->
            <div class="space-y-3">
              <label class="block text-base font-semibold text-choco">
                เพศ <span class="text-red-500">*</span>
              </label>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                
                <label class="option-card border-2 border-cream-border rounded-2xl p-4 flex items-center justify-between" onclick="selectRadio('gender', this)">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-500 flex items-center justify-center text-lg">
                      <i class="fa-solid fa-mars"></i>
                    </div>
                    <span class="font-medium text-choco">ชาย</span>
                  </div>
                  <input type="radio" name="gender" value="ชาย" required class="w-4 h-4 text-honey focus:ring-honey">
                </label>

                <label class="option-card border-2 border-cream-border rounded-2xl p-4 flex items-center justify-between" onclick="selectRadio('gender', this)">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-pink-50 text-pink-500 flex items-center justify-center text-lg">
                      <i class="fa-solid fa-venus"></i>
                    </div>
                    <span class="font-medium text-choco">หญิง</span>
                  </div>
                  <input type="radio" name="gender" value="หญิง" required class="w-4 h-4 text-honey focus:ring-honey">
                </label>

                <label class="option-card border-2 border-cream-border rounded-2xl p-4 flex items-center justify-between" onclick="selectRadio('gender', this)">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-purple-50 text-purple-500 flex items-center justify-center text-lg">
                      <i class="fa-solid fa-user-secret"></i>
                    </div>
                    <span class="font-medium text-choco">ไม่ประสงค์ระบุ</span>
                  </div>
                  <input type="radio" name="gender" value="ไม่ประสงค์ระบุ" required class="w-4 h-4 text-honey focus:ring-honey">
                </label>

              </div>
            </div>

            <!-- 1.2 Age -->
            <div class="space-y-3">
              <label class="block text-base font-semibold text-choco">
                อายุ <span class="text-red-500">*</span>
              </label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">

                <label class="option-card border-2 border-cream-border rounded-2xl p-4 flex flex-col items-center justify-center text-center gap-2" onclick="selectRadio('age', this)">
                  <span class="text-2xl">🌱</span>
                  <span class="font-medium text-choco text-sm">ต่ำกว่า 15 ปี</span>
                  <input type="radio" name="age" value="ต่ำกว่า 15 ปี" required class="w-4 h-4 text-honey focus:ring-honey mt-1">
                </label>

                <label class="option-card border-2 border-cream-border rounded-2xl p-4 flex flex-col items-center justify-center text-center gap-2" onclick="selectRadio('age', this)">
                  <span class="text-2xl">🎓</span>
                  <span class="font-medium text-choco text-sm">15–18 ปี</span>
                  <input type="radio" name="age" value="15–18 ปี" required class="w-4 h-4 text-honey focus:ring-honey mt-1">
                </label>

                <label class="option-card border-2 border-cream-border rounded-2xl p-4 flex flex-col items-center justify-center text-center gap-2" onclick="selectRadio('age', this)">
                  <span class="text-2xl">⚡</span>
                  <span class="font-medium text-choco text-sm">19–22 ปี</span>
                  <input type="radio" name="age" value="19–22 ปี" required class="w-4 h-4 text-honey focus:ring-honey mt-1">
                </label>

                <label class="option-card border-2 border-cream-border rounded-2xl p-4 flex flex-col items-center justify-center text-center gap-2" onclick="selectRadio('age', this)">
                  <span class="text-2xl">💼</span>
                  <span class="font-medium text-choco text-sm">23 ปีขึ้นไป</span>
                  <input type="radio" name="age" value="23 ปีขึ้นไป" required class="w-4 h-4 text-honey focus:ring-honey mt-1">
                </label>

              </div>
            </div>

            <!-- 1.3 Ever Ate Cheese Pie? -->
            <div class="space-y-3">
              <label class="block text-base font-semibold text-choco">
                คุณเคยรับประทานชีสพายหรือไม่ <span class="text-red-500">*</span>
              </label>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                
                <label class="option-card border-2 border-cream-border rounded-2xl p-4 flex items-center justify-between" onclick="selectRadio('hasEaten', this)">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg">
                      <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <div>
                      <span class="font-medium text-choco block">เคย</span>
                      <span class="text-xs text-choco-soft">เคยกินชีสพาย / ชีสเค้กถ้วยมาก่อน</span>
                    </div>
                  </div>
                  <input type="radio" name="hasEaten" value="เคย" required class="w-4 h-4 text-honey focus:ring-honey">
                </label>

                <label class="option-card border-2 border-cream-border rounded-2xl p-4 flex items-center justify-between" onclick="selectRadio('hasEaten', this)">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-orange-50 text-orange-500 flex items-center justify-center text-lg">
                      <i class="fa-solid fa-circle-xmark"></i>
                    </div>
                    <div>
                      <span class="font-medium text-choco block">ไม่เคย</span>
                      <span class="text-xs text-choco-soft">ยังไม่เคยลองทานชีสพาย</span>
                    </div>
                  </div>
                  <input type="radio" name="hasEaten" value="ไม่เคย" required class="w-4 h-4 text-honey focus:ring-honey">
                </label>

              </div>
            </div>

          </div>
        </div>

        <!-- SECTION 2: ความชื่นชอบในรสชาติ -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-cream-border/60 relative overflow-hidden">
          <div class="absolute top-0 left-0 w-2 h-full bg-honey-gold"></div>

          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-cream-border/40">
            <span class="w-10 h-10 rounded-2xl bg-honey/15 text-honey-gold flex items-center justify-center font-bold text-lg">2</span>
            <div>
              <h3 class="text-xl font-bold text-choco">ส่วนที่ 2 ความชื่นชอบในรสชาติ</h3>
              <p class="text-xs text-choco-soft">สำรวจรสชาติโปรดและไอเดียรสชาติใหม่ๆ ของคุณ</p>
            </div>
          </div>

          <div class="space-y-8">

            <!-- 2.1 Favorite Flavor Selection -->
            <div class="space-y-3">
              <label class="block text-base font-semibold text-choco">
                คุณสนใจชีสพายรสชาติใดมากที่สุด <span class="text-red-500">*</span>
              </label>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

                <!-- Blueberry -->
                <label class="option-card border-2 border-cream-border rounded-2xl p-4 flex items-center justify-between bg-indigo-50/20" onclick="selectRadio('favoriteFlavor', this)">
                  <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-xl bg-indigo-100 text-2xl flex items-center justify-center shadow-xs">
                      🫐
                    </div>
                    <div>
                      <span class="font-bold text-choco block text-base">บลูเบอร์รี่ชีสพาย</span>
                      <span class="text-xs text-indigo-600 font-medium">Blueberry Cheese Pie</span>
                    </div>
                  </div>
                  <input type="radio" name="favoriteFlavor" value="บลูเบอร์รี่ชีสพาย 🫐" required class="w-5 h-5 text-honey focus:ring-honey">
                </label>

                <!-- Strawberry -->
                <label class="option-card border-2 border-cream-border rounded-2xl p-4 flex items-center justify-between bg-rose-50/20" onclick="selectRadio('favoriteFlavor', this)">
                  <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-xl bg-rose-100 text-2xl flex items-center justify-center shadow-xs">
                      🍓
                    </div>
                    <div>
                      <span class="font-bold text-choco block text-base">สตรอว์เบอร์รี่ชีสพาย</span>
                      <span class="text-xs text-rose-600 font-medium">Strawberry Cheese Pie</span>
                    </div>
                  </div>
                  <input type="radio" name="favoriteFlavor" value="สตรอว์เบอร์รี่ชีสพาย 🍓" required class="w-5 h-5 text-honey focus:ring-honey">
                </label>

                <!-- Chocolate -->
                <label class="option-card border-2 border-cream-border rounded-2xl p-4 flex items-center justify-between bg-amber-50/20" onclick="selectRadio('favoriteFlavor', this)">
                  <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-xl bg-amber-100 text-2xl flex items-center justify-center shadow-xs">
                      🍫
                    </div>
                    <div>
                      <span class="font-bold text-choco block text-base">ช็อกโกแลตชีสพาย</span>
                      <span class="text-xs text-amber-700 font-medium">Chocolate Cheese Pie</span>
                    </div>
                  </div>
                  <input type="radio" name="favoriteFlavor" value="ช็อกโกแลตชีสพาย 🍫" required class="w-5 h-5 text-honey focus:ring-honey">
                </label>

                <!-- Oreo -->
                <label class="option-card border-2 border-cream-border rounded-2xl p-4 flex items-center justify-between bg-slate-50/40" onclick="selectRadio('favoriteFlavor', this)">
                  <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-xl bg-slate-200 text-2xl flex items-center justify-center shadow-xs">
                      🍪
                    </div>
                    <div>
                      <span class="font-bold text-choco block text-base">โอริโอ้ชีสพาย</span>
                      <span class="text-xs text-slate-700 font-medium">Oreo Cheese Pie</span>
                    </div>
                  </div>
                  <input type="radio" name="favoriteFlavor" value="โอริโอ้ชีสพาย 🍪" required class="w-5 h-5 text-honey focus:ring-honey">
                </label>

              </div>
            </div>

            <!-- 2.2 Open suggestion for new flavor -->
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <label for="newFlavorSuggestion" class="block text-base font-semibold text-choco">
                  คุณอยากให้เราเพิ่มรสชาติเพิ่มไหม แล้วเป็นรสชาติอะไร
                </label>
                <span class="text-xs font-medium text-choco-soft bg-cream-bg px-2.5 py-1 rounded-full border border-cream-border">
                  ไม่บังคับตอบ (Optional)
                </span>
              </div>
              <textarea 
                id="newFlavorSuggestion" 
                name="newFlavorSuggestion" 
                rows="3" 
                placeholder="พิมพ์รสชาติที่คุณอยากทาน เช่น มัทฉะชาเขียว 🍵, มะม่วงสุก 🥭, ชาไทยครีม cheese 🧋 ฯลฯ"
                class="w-full rounded-2xl border-2 border-cream-border focus:border-honey focus:ring focus:ring-honey/20 p-4 text-sm text-choco placeholder-choco-soft/50 transition duration-200 resize-none outline-none"
              ></textarea>
            </div>

          </div>
        </div>

        <!-- SUBMIT BUTTON -->
        <div class="flex justify-center pt-2">
          <button 
            type="submit" 
            class="w-full sm:w-auto px-10 py-4 rounded-2xl bg-gradient-to-r from-honey-gold via-honey to-honey-dark text-white font-bold text-lg shadow-lg hover:shadow-xl hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 flex items-center justify-center gap-3"
          >
            <i class="fa-solid fa-paper-plane"></i>
            <span>ส่งแบบประเมิน DEKAUAN</span>
          </button>
        </div>

      </form>
    </section>

    <!-- ==================== TAB 2: RESULTS DASHBOARD ==================== -->
    <section id="tab-content-dashboard" class="space-y-8 hidden animate-fade-in">
      
      <!-- DASHBOARD TITLE & ACTIONS -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-cream-border/60 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 text-honey-gold text-xs font-bold uppercase tracking-wider mb-1">
